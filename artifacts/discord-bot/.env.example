# ─────────────────────────────────────────────────────────
#  🎬 Premiere Bot — Variáveis de Ambiente
#  Copie este arquivo para .env e preencha os valores reais
# ─────────────────────────────────────────────────────────

# Token do bot (Discord Developer Portal → Bot → Reset Token)
TOKEN=

# ID do aplicativo/bot (Discord Developer Portal → OAuth2 → Client ID)
CLIENT_ID=

# ID do servidor Discord onde os comandos serão registrados
# Clique com botão direito no servidor → Copiar ID do servidor
GUILD_ID=

# URL de conexão com o banco PostgreSQL
# Exemplos:
#   Replit:    definido automaticamente como DATABASE_URL
#   Railway:   postgresql://postgres:senha@host.railway.app:5432/railway
#   Supabase:  postgresql://postgres:senha@db.xxxx.supabase.co:5432/postgres
#   Neon:      postgresql://usuario:senha@ep-xxx.us-east-1.aws.neon.tech/neondb
#   Local:     postgresql://postgres:senha@localhost:5432/premiere
DATABASE_URL=
